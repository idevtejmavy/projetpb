<?xml version="1.0" encoding="utf-8"?>
<!--
     Recapitulatif d'une Enquete Menage avant enregistrement - lot 3.

     La liste occupe la hauteur restante et defile seule, le bouton reste visible en bas. Les
     recapitulatifs existants enferment leur liste dans un conteneur de hauteur fixe place dans un
     ScrollView : au-dela d'une dizaine de lignes le contenu est coupe. Une enquete avec trois
     fiches enfant en compte plus de soixante.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".activities.infospresenters.EnqueteMenagePreviewActivity">

    <RelativeLayout
        android:id="@+id/linealToolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_70sdp"
        android:background="@color/progband_gris">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/clickCloseBtn"
            android:layout_width="@dimen/page_icon_head_dim35"
            android:layout_height="@dimen/page_icon_head_dim35"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            app:srcCompat="@drawable/ic_back_black" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/labelTitleMenuAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/recapitulatif_enquete_menage"
            android:textColor="@color/text_color_white"
            android:textSize="@dimen/page_title_dim14"
            android:textStyle="bold" />

    </RelativeLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/labelAvertissementRecap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        android:background="@drawable/rounded_background"
        android:padding="@dimen/_10sdp"
        android:text="@string/relisez_avant_d_enregistrer"
        android:textSize="@dimen/page_input_title_dim11" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerInfoPrev"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="@dimen/_10sdp"
        android:layout_weight="1"
        android:background="@drawable/rounded_cardview_with_border"
        android:padding="@dimen/_10sdp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:itemCount="10"
        tools:listitem="@layout/infos_livraiison_prev_items_list" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_10sdp"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clickSaveEnquetePreview"
            style="@style/OptionsButton_Active"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginStart="@dimen/_5sdp"
            android:layout_marginEnd="@dimen/_5sdp"
            android:backgroundTint="@color/progband_green"
            android:elevation="0dp"
            android:text="@string/enregistrer_l_enquete"
            android:textColor="@color/text_color_white"
            android:textSize="@dimen/page_button_text_dim13"
            app:cornerRadius="@dimen/_37sdp"
            app:icon="@drawable/baseline_schedule_send_prev_white"
            app:iconGravity="start"
            app:iconSize="@dimen/page_icon_other_dim20"
            app:iconTint="@color/white_color" />

    </LinearLayout>

</LinearLayout>
