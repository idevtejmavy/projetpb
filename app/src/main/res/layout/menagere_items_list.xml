<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:paddingEnd="@dimen/_16sdp"
    android:paddingStart="@dimen/_16sdp"
    android:paddingTop="@dimen/_5sdp"
    android:paddingBottom="@dimen/_5sdp"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/linearMenagereContainerItem"
        android:layout_toLeftOf="@+id/imgSyncedMenage"
        android:layout_centerHorizontal="true"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/item_title"
                android:textColor="@color/text_color_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quartier : "/>

            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/text_color_white"
                android:id="@+id/labelQuartierMenagere"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="APO-12"
                android:textSize="@dimen/_11ssp"
                android:textStyle="bold"/>

        </LinearLayout>

        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/item2_title"
                android:textColor="@color/text_color_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Producteur : "
                android:maxLines="3"
                android:textSize="@dimen/_15ssp"
                android:textStyle="bold"/>

            <Space
                android:layout_width="@dimen/_5sdp"
                android:layout_height="wrap_content"/>

            <androidx.appcompat.widget.AppCompatTextView
android:textColor="@color/text_color_white"
                android:id="@+id/labelProducteurNomMenagere"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="JOE JOEJOEJOEJOEJOEJOEJOEJOEJOEJOEJOE"
                android:ellipsize="end"
                android:maxLines="3"
                android:textSize="@dimen/_12ssp"
                />

        </LinearLayout>

    
        <!-- Motif du dernier refus du serveur pour ce module (masque si le dernier envoi a abouti) -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/labelErreurEnvoi"
            android:visibility="gone"
            tools:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_3sdp"
            android:layout_marginEnd="@dimen/_30sdp"
            android:textColor="@color/red_title"
            android:textSize="@dimen/_8ssp"
            android:maxLines="3"
            android:ellipsize="end"
            tools:text="Envoi refusé : erreur 500 du serveur. La saisie est conservée. (13:38)" />

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imgSyncedMenage"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_30sdp"
        tools:src="@drawable/ic_sync_donz"
        android:layout_alignParentEnd="true"
        android:layout_alignBottom="@+id/linearMenagereContainerItem"
        android:layout_marginBottom="@dimen/_minus5sdp"/>

</RelativeLayout>